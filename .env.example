# Copiar a WEB/.env. Los valores del entorno del proceso prevalecen.
HOST=127.0.0.1
PORT=8080
DATA_DIR=data
DEVICE_ID=pluvia-01
# Generar valores diferentes de alta entropía. Vacíos deshabilitan sus accesos.
DEVICE_TOKEN=
MONITOR_PASSWORD=
# true detrás del proxy HTTPS; false únicamente para la exhibición HTTP en red de confianza.
COOKIE_SECURE=false
DEMO_INTERVAL_SECONDS=2
STALE_SECONDS=10
OFFLINE_SECONDS=30
